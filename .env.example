# Firebase Web App Configuration (from Firebase Console or `npx firebase-tools apps:sdkconfig WEB`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA Enterprise Site Key for Production Web)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local Development / CI Only — NEVER commit real debug tokens!
# Set to a registered UUID debug token or "true" locally for localhost development.
VITE_APP_CHECK_DEBUG_TOKEN=

# Optional cloud model override (defaults to gemini-3.5-flash-lite)
VITE_FIREBASE_AI_CLOUD_MODEL=gemini-3.5-flash-lite
